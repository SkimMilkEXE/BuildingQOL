Keybinds: {
	"Clear Selection.DisplayName": Clear  Selection
	"Set Selection Corner 2.DisplayName": Set  Selection  Corner 2
	"Set Selection Corner 1.DisplayName": Set  Selection  Corner 1
	"Paste Selection.DisplayName": Paste  Selection
	"Copy Selection.DisplayName": Copy  Selection
	"Erase Selection Tiles.DisplayName": Erase  Selection  Tiles
	"Toggle Tile Grid.DisplayName": Toggle  Tile  Grid
	Redo.DisplayName: Redo
	Undo.DisplayName: Undo
	"Load Schematic From File.DisplayName": Load  Schematic  From  File
	"Save Schematic To File.DisplayName": Save  Schematic  To  File
	"Toggle Cursor Highlight.DisplayName": Toggle  Cursor  Highlight
	"Cycle Terrain Wand Mode.DisplayName": Cycle  Terrain  Wand  Mode
}

Configs: {
	BuildingQOLConfig: {
		AutoReframeOnPaste: {
			Tooltip: Recalculates tile/wall visuals in and around the pasted area so it blends with neighbors
			Label: Auto-reframe on paste
		}

		OutlineThickness: {
			Tooltip: ""
			Label: Outline Thickness
		}

		OutlineColor: {
			Tooltip: ""
			Label: Outline Color
		}

		DisplayName: Building Q O L Config

		TerrainStepAmount: {
			Tooltip: How many tiles Raise/Lower shifts terrain by per use
			Label: Terrain Wand step amount
		}

		TerrainBrushRadius: {
			Tooltip: How many columns on each side of your cursor the Terrain Wand affects per use
			Label: Terrain Wand brush radius
		}
	}
}

Items: {
	TerrainWand: {
		Tooltip: '''
			Sculpts terrain in a strip around your cursor
			Left click to apply the current mode
			Cycle Raise / Lower / Smooth / Roughen with its keybind
			'''
		DisplayName: Terrain Wand
	}
}
